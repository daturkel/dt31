    CP , R.a
; A quine: running this program prints its own source.
;
; The number on line 1 is the rest of this file, one character per base-128
; digit, least significant first. The program prints line 1 around that number,
; then unpacks it to print everything else.

    ; print line 1
    COUT ' '
    COUT ' '
    COUT ' '
    COUT ' '
    COUT 'C'
    COUT 'P'
    COUT ' '
    NOUT R.a
    COUT ','
    COUT ' '
    COUT 'R'
    COUT '.'
    COUT 'a', 1

; print the rest, one base-128 digit at a time
loop:
    MOD R.a, 128, R.c
    COUT R.c
    DIV R.a, 128
    JGT loop, R.a, 0
